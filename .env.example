# Copie para .env.local no desenvolvimento e configure as mesmas variáveis na Vercel (Settings > Environment Variables).
# Nunca use o prefixo NEXT_PUBLIC em segredos.

# Banco Postgres. Na Vercel, a integração Neon (Storage) preenche automaticamente.
DATABASE_URL=

# Login (painel do Clerk > API Keys).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Agenda do Outlook/Teams e do Google: sem variável nova. As credenciais OAuth vão no painel do Clerk (docs/agenda-integracao.md).

# Opcional: assistente com IA. Sem estas variáveis, o assistente usa o modo guiado.
AI_API_KEY=
AI_MODEL=
# Opcional: endpoint compatível com a API da OpenAI (proxy, Azure, OpenRouter etc.). Vazio usa a OpenAI.
AI_BASE_URL=

# Opcional: bot do Telegram (token do @BotFather).
TELEGRAM_BOT_TOKEN=
# Opcional: endereço alternativo da Bot API, usado apenas em testes locais.
TELEGRAM_API_BASE=

# Opcional: WhatsApp pela Evolution API (endereço público, como um túnel ngrok; chave global; nome da instância).
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=

# Menu Testosterona
# Arquivos dos exames: conecte um Vercel Blob privado ao projeto (cria BLOB_STORE_ID/BLOB_READ_WRITE_TOKEN).
# Localmente, EXAM_FILES=memory guarda os arquivos na memória do servidor de desenvolvimento.
EXAM_FILES=
# Protege a rota do lembrete diário (/api/cron/trt-reminders). A Vercel envia este valor no cabeçalho Authorization.
CRON_SECRET=
