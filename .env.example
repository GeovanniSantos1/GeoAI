# Copie para .env.local no desenvolvimento e configure as mesmas variáveis na Vercel (Settings > Environment Variables).
# Nunca use o prefixo NEXT_PUBLIC em segredos.

# Banco Postgres. Na Vercel, a integração Neon (Storage) preenche automaticamente.
DATABASE_URL=

# Login (painel do Clerk > API Keys).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Opcional: assistente com IA. Sem estas variáveis, o assistente usa o modo guiado.
AI_API_KEY=
AI_MODEL=
# Opcional: endpoint compatível com a API da OpenAI (proxy, Azure, OpenRouter etc.). Vazio usa a OpenAI.
AI_BASE_URL=

# Opcional: bot do Telegram (token do @BotFather).
TELEGRAM_BOT_TOKEN=
# Opcional: endereço alternativo da Bot API, usado apenas em testes locais.
TELEGRAM_API_BASE=
