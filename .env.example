# Opcional: configurar como segredo no servidor. Nunca usar prefixo NEXT_PUBLIC.
AI_API_KEY=
AI_MODEL=
# Opcional: endpoint compatível com a API da OpenAI (proxy, Azure, OpenRouter etc.). Vazio usa a OpenAI.
AI_BASE_URL=
# Opcional: token do bot do Telegram (gerado no @BotFather). Configure só como segredo no servidor, nunca no código.
TELEGRAM_BOT_TOKEN=
# Opcional: endereço alternativo da Bot API, usado apenas em testes locais.
TELEGRAM_API_BASE=
